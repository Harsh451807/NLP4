        "# CELL 14: BONUS — EXPERIMENT 4: DistilBERT\n",
        "# 40% smaller, 60% faster than BERT\n",
        "# ============================================================\n",
        "print(\"=\" * 70)\n",
        "print(\"  BONUS EXPERIMENT 4: DistilBERT Full Fine-Tuning\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "DISTILBERT_NAME = 'distilbert-base-uncased'\n",
        "\n",
        "# Tokenize with DistilBERT tokenizer\n",
        "distil_tokenizer = AutoTokenizer.from_pretrained(DISTILBERT_NAME)\n",
        "\n",
        "print(\"Tokenizing for DistilBERT...\")\n",
        "train_enc_d = distil_tokenizer(list(train_texts), truncation=True, padding=True,\n",
        "                                max_length=MAX_LEN, return_tensors='pt')\n",
        "val_enc_d   = distil_tokenizer(list(val_texts), truncation=True, padding=True,\n",
        "                                max_length=MAX_LEN, return_tensors='pt')\n",
        "test_enc_d  = distil_tokenizer(list(test_texts), truncation=True, padding=True,\n",
        "                                max_length=MAX_LEN, return_tensors='pt')\n",
        "\n",
        "# Datasets & Loaders\n",
        "train_ds_d = IMDBDataset(train_enc_d, train_labels)\n",
        "val_ds_d   = IMDBDataset(val_enc_d, val_labels)\n",
        "test_ds_d  = IMDBDataset(test_enc_d, test_labels)\n",
        "\n",
        "train_ld_d = DataLoader(train_ds_d, batch_size=BATCH_SIZE, shuffle=True)\n",
        "val_ld_d   = DataLoader(val_ds_d, batch_size=BATCH_SIZE, shuffle=False)\n",
        "test_ld_d  = DataLoader(test_ds_d, batch_size=BATCH_SIZE, shuffle=False)\n",
        "\n",
        "# Load model\n",
        "model_exp4 = AutoModelForSequenceClassification.from_pretrained(DISTILBERT_NAME, num_labels=2)\n",
        "model_exp4.to(device)\n",
        "\n",
        "total_p = sum(p.numel() for p in model_exp4.parameters())\n",
        "print(f\"\\nDistilBERT parameters: {total_p:,}\")\n",
        "\n",
        "# Optimizer\n",
        "optimizer = AdamW(model_exp4.parameters(), lr=LEARNING_RATE, weight_decay=0.01)\n",
        "total_steps = len(train_ld_d) * EPOCHS\n",
        "scheduler = get_linear_schedule_with_warmup(\n",
        "    optimizer, num_warmup_steps=int(0.1 * total_steps), num_training_steps=total_steps\n",
        ")\n",
        "\n",
        "# Training\n",
        "train_losses_4, val_losses_4, train_accs_4, val_accs_4 = [], [], [], []\n",
        "best_val_acc = 0\n",
        "\n",
        "for epoch in range(EPOCHS):\n",
        "    print(f\"\\n--- Epoch {epoch+1}/{EPOCHS} ---\")\n",
        "    t_loss, t_acc = train_epoch(model_exp4, train_ld_d, optimizer, scheduler, device)\n",
        "    v_loss, v_acc, _, _ = evaluate(model_exp4, val_ld_d, device)\n",
        "\n",
        "    train_losses_4.append(t_loss)\n",
        "    val_losses_4.append(v_loss)\n",
        "    train_accs_4.append(t_acc)\n",
        "    val_accs_4.append(v_acc)\n",
        "\n",
        "    print(f\"  Train Loss: {t_loss:.4f} | Train Acc: {t_acc:.4f}\")\n",
        "    print(f\"  Val Loss:   {v_loss:.4f} | Val Acc:   {v_acc:.4f}\")\n",
        "\n",
        "    if v_acc > best_val_acc:\n",
        "        best_val_acc = v_acc\n",
        "        torch.save(model_exp4.state_dict(), 'best_exp4.pt')\n",
        "        print(f\"  ✅ Best model saved!\")\n",
        "\n",
        "# Test evaluation\n",
        "model_exp4.load_state_dict(torch.load('best_exp4.pt'))\n",
        "_, _, preds_4, labels_4 = evaluate(model_exp4, test_ld_d, device)\n",
        "metrics_exp4 = compute_metrics(labels_4, preds_4, \"Exp4: DistilBERT\")\n",
        "plot_training_history(train_losses_4, val_losses_4, train_accs_4, val_accs_4, \"Exp4 DistilBERT\")\n",
        "plot_confusion_matrix(metrics_exp4['confusion_matrix'], \"Exp4 DistilBERT\")"
      ],
