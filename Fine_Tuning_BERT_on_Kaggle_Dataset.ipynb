        "# ============================================================\n",
        "# CELL 6: DATA PREPROCESSING (MANDATORY)\n",
        "# ============================================================\n",
        "\n",
        "def clean_text(text):\n",
        "    \"\"\"\n",
        "    Text cleaning function for IMDB reviews:\n",
        "    1. Remove HTML tags (<br />, <p>, etc.)\n",
        "    2. Remove URLs\n",
        "    3. Remove email addresses\n",
        "    4. Remove special characters\n",
        "    5. Remove extra whitespace\n",
        "    6. Convert to lowercase\n",
        "    \"\"\"\n",
        "    text = str(text)\n",
        "    text = re.sub(r'<[^>]+>', ' ', text)                      # HTML tags\n",
        "    text = re.sub(r'http\\S+|www\\S+|https\\S+', '', text)       # URLs\n",
        "    text = re.sub(r'\\S+@\\S+', '', text)                        # Emails\n",
        "    text = re.sub(r'[^a-zA-Z0-9\\s.,!?\\'\"-]', ' ', text)       # Special chars\n",
        "    text = re.sub(r'\\s+', ' ', text).strip()                   # Extra spaces\n",
        "    text = text.lower()                                         # Lowercase\n",
        "    return text\n",
        "\n",
        "# -----------------------------------------------------------\n",
        "# Handle missing values and duplicates\n",
        "# -----------------------------------------------------------\n",
        "print(\"BEFORE CLEANING:\")\n",
        "print(f\"  Total rows: {len(df)}\")\n",
        "print(f\"  Missing values:\\n{df.isnull().sum()}\")\n",
        "print(f\"  Duplicates: {df.duplicated(subset=['review']).sum()}\")\n",
        "\n",
        "# Drop missing and duplicates\n",
        "df = df.dropna(subset=['review'])\n",
        "df = df.drop_duplicates(subset=['review'], keep='first')\n",
        "\n",
        "# -----------------------------------------------------------\n",
        "# Apply text cleaning\n",
        "# -----------------------------------------------------------\n",
        "print(\"\\nCleaning text...\")\n",
        "df['clean_text'] = df['review'].apply(clean_text)\n",
        "\n",
        "# Remove empty strings\n",
        "df = df[df['clean_text'].str.len() > 0]\n",
        "\n",
        "print(f\"\\nAFTER CLEANING:\")\n",
        "print(f\"  Total rows: {len(df)}\")\n",
        "print(f\"  Missing values:\\n{df[['review','clean_text','label']].isnull().sum()}\")\n",
        "\n",
        "# -----------------------------------------------------------\n",
        "# Show before vs after\n",
        "# -----------------------------------------------------------\n",
        "print(f\"\\n{'='*60}\")\n",
        "print(\"BEFORE CLEANING:\")\n",
        "print(f\"{'='*60}\")\n",
        "print(df['review'].iloc[0][:400])\n",
        "print(f\"\\n{'='*60}\")\n",
        "print(\"AFTER CLEANING:\")\n",
        "print(f\"{'='*60}\")\n",
        "print(df['clean_text'].iloc[0][:400])\n",
        "\n",
        "# Drop helper column\n",
        "df = df.drop(columns=['word_count'], errors='ignore')\n",
        "print(f\"\\n✅ Preprocessing complete! Final shape: {df.shape}\")"
