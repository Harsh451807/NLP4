        "encoded = tokenizer(sample, padding=True, truncation=True, max_length=128)\n",
        "print(\"TOKENIZATION DEMO:\")\n",
        "print(f\"  Text:    {sample}\")\n",
        "print(f\"  Tokens:  {tokenizer.convert_ids_to_tokens(encoded['input_ids'])}\")\n",
        "print(f\"  IDs:     {encoded['input_ids']}\")\n",
        "\n",
        "# -----------------------------------------------------------\n",
        "# Tokenize all data\n",
        "# -----------------------------------------------------------\n",
        "MAX_LEN = 256\n",
        "\n",
        "print(f\"\\nTokenizing all data (MAX_LEN={MAX_LEN})...\")\n",
        "\n",
        "train_encodings = tokenizer(\n",
        "    list(train_texts), truncation=True, padding=True,\n",
        "    max_length=MAX_LEN, return_tensors='pt'\n",
        ")\n",
        "\n",
        "val_encodings = tokenizer(\n",
